# The complete prototype works without any API keys.
# Runtime port (Railway provides PORT automatically).
PORT=8000

# Reserved for future AI extraction/drafting. These are NOT wired into the prototype.
# Add integrations server-side before enabling; never place keys in static/app.js.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional deployment credentials for your local deployment tooling only.
# Railway's connected GitHub deployment does not need these in the app environment.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
RAILWAY_TOKEN=
