# No API keys are needed for this browser-only prototype.
# Reserved for a future SERVER-SIDE integration; not read by the current app.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional local/CI deployment credentials. Never bundle them into browser code.
# Existing Wrangler OAuth login can deploy without these variables.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Reserved only if Railway is used in a future backend version.
RAILWAY_TOKEN=
