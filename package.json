{
  "name": "bill-buster",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev --port 8001",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check static/app.js && node --check core/engine.js && node --check core/documents.js && node --check core/ncci.js"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "unpdf": "1.4.0"
  },
  "devDependencies": {
    "wrangler": "4.131.0",
    "esbuild": "0.28.1"
  }
}
